{
  "name": "markd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.4.1"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "corepack pnpm --filter @markd/web dev",
    "build": "corepack pnpm --filter @markd/web build",
    "start": "corepack pnpm --filter @markd/web start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p packages/tsconfig.json && corepack pnpm --filter @markd/web typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "env:local": "node scripts/env-local.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration:new": "supabase migration new",
    "db:types": "node scripts/generate-db-types.ts",
    "db:types:check": "node scripts/generate-db-types.ts --check",
    "db:backup-restore-drill": "node scripts/disposable-backup-restore-drill.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
