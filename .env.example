NEXT_PUBLIC_SUPABASE_URL=
# `pnpm env:local` writes this from `pnpm db:start`; do not enter it manually.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# `pnpm env:local` writes this from `pnpm db:start`; do not enter it manually.

# Server-only Supabase access. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Local: `pnpm db:status` prints the service role key. Hosted: Supabase Dashboard > Project Settings > API.

WHATSAPP_VERIFY_TOKEN=
# Create a random value, then paste the same value into Meta App Dashboard > WhatsApp > Configuration > Verify token.
WHATSAPP_APP_SECRET=
# Meta App Dashboard > App settings > Basic > App secret.
WHATSAPP_ACCESS_TOKEN=
# Meta App Dashboard > WhatsApp > API Setup > Temporary access token for testing, or a system-user token for staging/production.
WHATSAPP_PHONE_NUMBER_ID=
# Meta App Dashboard > WhatsApp > API Setup > Phone number ID.

OPENROUTER_API_KEY=
# Create a key at https://openrouter.ai/settings/keys. Its presence enables the configured server-only provider.
