NEXT_PUBLIC_SUPABASE_URL=
# `pnpm env:local` writes this from `pnpm db:start`; do not enter it manually.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# `pnpm env:local` writes this from `pnpm db:start`; do not enter it manually.

# Server-only Supabase access. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Local: `pnpm db:status` prints the service role key. Hosted: Supabase Dashboard > Project Settings > API.

WHATSAPP_VERIFY_TOKEN=
# Create a random value, then paste the same value into Meta App Dashboard > WhatsApp > Configuration > Verify token.
WHATSAPP_APP_SECRET=
# Meta App Dashboard > App settings > Basic > App secret.
WHATSAPP_ACCESS_TOKEN=
# Meta App Dashboard > WhatsApp > API Setup > Temporary access token for testing, or a system-user token for staging/production.
WHATSAPP_PHONE_NUMBER_ID=
# Meta App Dashboard > WhatsApp > API Setup > Phone number ID.

OPENROUTER_API_KEY=
# Create a key at https://openrouter.ai/settings/keys. Its presence enables the configured server-only provider.

INTERNAL_SERVICE_TOKEN=
# Generate a distinct high-entropy token for FastAPI worker/scheduler delivery queue requests. Never expose it to a browser.

MARKD_PROCESS_ROLE=api
# Deploy a second instance of the same FastAPI image with MARKD_PROCESS_ROLE=worker.
WORKER_POLL_INTERVAL_SECONDS=10

# Optional FastAPI provider controls. Keep the defaults unless a controlled provider change is approved.
WHATSAPP_GRAPH_API_VERSION=v24.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_MAX_MEDIA_BYTES=12582912
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_INTENT_MODEL=openai/gpt-4.1-mini
OPENROUTER_INTENT_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TRANSCRIPTION_MODEL=google/gemini-2.5-flash
OPENROUTER_TRANSCRIPTION_FALLBACK_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_INTENT_MAX_TOKENS=300
OPENROUTER_TRANSCRIPTION_MAX_TOKENS=500
OPENROUTER_INTENT_MAX_COST_USD=0.01
OPENROUTER_TRANSCRIPTION_MAX_COST_USD=0.03

# FastAPI application boundary. These values are server-only.
SUPABASE_DB_URL=
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_JWT_SECRET=
# Local: `pnpm db:status` prints the JWT secret. Hosted: Supabase project JWT secret/JWKS configuration.
SUPABASE_JWT_AUDIENCE=authenticated
MARKD_API_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=["http://localhost:3000"]
